COMPOSE_PROJECT_NAME=payment_processing

# Db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=payments
# For local start without docker host = localhost
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/payments

# Queue
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Api
API_KEY=your_static_api_key_here

# Outbox relay
OUTBOX_POLL_INTERVAL=2.0
OUTBOX_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT=10.0
OUTBOX_BATCH_SIZE=50