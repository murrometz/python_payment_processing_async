# syntax=docker/dockerfile:1.4
FROM python:3.11-slim AS base
WORKDIR /app

# ---------- Установка зависимостей ----------
FROM base AS dependencies
COPY pyproject.toml poetry.lock ./
RUN pip install poetry && \
    poetry config virtualenvs.create false && \
    # Устанавливаем только группу consumer и основные зависимости
    poetry install --no-interaction --no-ansi --only main,consumer

# ---------- Запуск приложения ----------
FROM base AS runtime
WORKDIR /app

# Копируем только виртуальное окружение с нужными пакетами
COPY --from=dependencies /app/.venv /app/.venv

# Копируем ТОЛЬКО те папки, которые нужны consumer-у для работы
# Ему нужны: настройки (src/database.py, src/models), сам consumer и messaging
COPY src/database.py src/models/ src/consumers/ src/messaging/ ./

# Активируем окружение
ENV PATH="/app/.venv/bin:$PATH"

# Запуск
CMD ["faststream", "run", "src.consumers.payment_consumer:broker", "--workers", "1"]